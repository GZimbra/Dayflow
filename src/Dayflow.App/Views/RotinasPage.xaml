<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Dayflow.App.ViewModels"
             x:Class="Dayflow.App.Views.RotinasPage"
             x:DataType="vm:RotinasViewModel"
             Title="Rotinas">
    <Grid Padding="{OnIdiom Phone='16,16', Default='28,24'}" RowDefinitions="Auto,*" RowSpacing="20" MaximumWidthRequest="1100">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="atividades recorrentes" Style="{StaticResource Sobrelinha}" />
                <Label Text="Rotinas" Style="{StaticResource Display}" />
            </VerticalStackLayout>
            <Button x:Name="BotaoNova" Grid.Column="1" Text="+  Nova rotina" VerticalOptions="End" Command="{Binding NovaCommand}" />
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Itens}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="LayoutGrade" Orientation="Vertical" Span="2" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,60" Spacing="8" HorizontalOptions="Center">
                    <Label Text="Nenhuma rotina" Style="{StaticResource Titulo}" HorizontalTextAlignment="Center" />
                    <Label Text="Crie atividades que se repetem, como checklists de abertura ou reuniões diárias." Style="{StaticResource Legenda}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:RotinaItemVm">
                    <Border Style="{StaticResource Cartao}" Opacity="{Binding Opacidade}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:RotinasViewModel}}, x:DataType=vm:RotinasViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LaranjaNevoa}, Dark={StaticResource LaranjaNevoaEscuro}}">
                                <Image Source="ic_rotina_laranja.png" WidthRequest="22" HeightRequest="22" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" LineBreakMode="WordWrap" />
                                <!-- Quebra de linha em tela estreita (projeto + dias personalizados não cabem em ~250 dp) -->
                                <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding Cor}" Margin="0,0,10,0" />
                                    <Label Text="{Binding Projeto}" Style="{StaticResource Legenda}" Margin="0,0,10,0" />
                                    <Label Text="·" Style="{StaticResource Legenda}" Margin="0,0,10,0" />
                                    <Label Text="{Binding Dias}" Style="{StaticResource Legenda}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                <Switch IsToggled="{Binding Ativa, Mode=OneWay}" InputTransparent="True" HorizontalOptions="End" />
                                <Button Text="{Binding Estado}" Style="{StaticResource BotaoTexto}"
                                        Command="{Binding AlternarAtivaCommand, Source={RelativeSource AncestorType={x:Type vm:RotinasViewModel}}, x:DataType=vm:RotinasViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
