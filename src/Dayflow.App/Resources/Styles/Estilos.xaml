<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tipografia: Manrope (texto) + IBM Plex Mono (números do cronômetro). Embutidas, OFL. -->
    <x:Double x:Key="TamDisplay">34</x:Double>
    <x:Double x:Key="TamTitulo">22</x:Double>
    <x:Double x:Key="TamSubtitulo">17</x:Double>
    <x:Double x:Key="TamCorpo">15</x:Double>
    <x:Double x:Key="TamLegenda">12.5</x:Double>
    <x:Double x:Key="RaioCartao">16</x:Double>
    <!-- Valores padrão (tablet). Em celular, Infra/Tela.AplicarDensidade troca na inicialização (DynamicResource). -->
    <x:Double x:Key="AltGrafico">300</x:Double>
    <x:Double x:Key="AltGraficoEmpilhado">240</x:Double>
    <Thickness x:Key="PaddingCartao">20</Thickness>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fundo}, Dark={StaticResource FundoEscuro}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource BasePreto}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource BaseBranco}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource BaseBranco}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource Trilho}, Dark={StaticResource TrilhoEscuro}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource BasePreto}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource BaseLaranja}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="#8C8C8C" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeBold" />
        <Setter Property="FontSize" Value="{DynamicResource TamDisplay}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
    </Style>
    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeBold" />
        <Setter Property="FontSize" Value="{DynamicResource TamTitulo}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource TamSubtitulo}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="Sobrelinha" TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
    </Style>
    <Style x:Key="Legenda" TargetType="Label">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="{StaticResource TamLegenda}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
    </Style>
    <Style x:Key="Mono" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexMono" />
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}" />
    </Style>

    <!-- Cartões -->
    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{DynamicResource PaddingCartao}" />
    </Style>
    <Style x:Key="Painel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuperficieAlta}, Dark={StaticResource SuperficieAltaEscuro}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Botões -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{StaticResource BaseLaranja}" />
        <Setter Property="TextColor" Value="{StaticResource BaseBranco}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource LaranjaPressionado}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BasePreto}, Dark={StaticResource BaseBranco}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BasePreto}, Dark={StaticResource BaseBranco}}" />
    </Style>
    <Style x:Key="BotaoTexto" TargetType="Button">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BaseLaranja}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="FontFamily" Value="ManropeSemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="ChipAtivo" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BasePreto}, Dark={StaticResource BaseBranco}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BasePreto}, Dark={StaticResource BaseBranco}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BaseBranco}, Dark={StaticResource BasePreto}}" />
    </Style>
    <Style x:Key="BotaoIcone" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Ícones (Path de traço) -->
    <Style x:Key="Icone" TargetType="Path">
        <Setter Property="WidthRequest" Value="22" />
        <Setter Property="HeightRequest" Value="22" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- Entradas -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Format" Value="dd/MM/yyyy" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Format" Value="HH:mm" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="ManropeRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource BaseLaranja}" />
        <Setter Property="ThumbColor" Value="{StaticResource BaseBranco}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource BaseLaranja}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource BaseLaranja}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource BaseLaranja}" />
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource BaseLaranja}" />
    </Style>
    <Style x:Key="Divisor" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
    </Style>
</ResourceDictionary>
