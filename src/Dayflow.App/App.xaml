<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:infra="clr-namespace:Dayflow.App.Infra"
             x:Class="Dayflow.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Cores.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icones.xaml" />
                <ResourceDictionary Source="Resources/Styles/Estilos.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <infra:NegarConverter x:Key="Negar" />
            <!-- Trilho de navegação: AppShell troca em runtime (ícones só no celular deitado). -->
            <x:Boolean x:Key="TrilhoComRotulos">True</x:Boolean>
            <!-- Celular em pé (largura < 600 dp): tabelas viram listas. AppShell atualiza ao girar. -->
            <x:Boolean x:Key="TelaEstreita">False</x:Boolean>
            <x:Boolean x:Key="TelaLarga">True</x:Boolean>
            <Thickness x:Key="MargemItemTrilho">12,2</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
