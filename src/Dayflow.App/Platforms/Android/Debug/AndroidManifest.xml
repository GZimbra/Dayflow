<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto de DEBUG — Dayflow 100% offline.
  * Nenhuma permissão de rede. As remoções com tools:node="remove" também eliminam
    permissões que bibliotecas (AARs) tentem injetar no merge do manifesto.
  * Sem backup: allowBackup=false (API ≤ 30) + dataExtractionRules excluindo tudo
    (API 31+ ignora allowBackup para transferência entre aparelhos).
  * Lembretes: AlarmManager inexato (sem SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM).
  Verificação: build/verificar-offline.sh (aapt dump permissions no APK final).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="Dayflow"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules" />

    <!-- Necessárias -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- DEBUG: sem as remoções; o depurador .NET usa socket local (INTERNET).
         NUNCA distribuir build Debug. Release usa ../AndroidManifest.xml. -->
</manifest>
